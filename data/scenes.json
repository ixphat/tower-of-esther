        "next": "c"
      },
      "c": {
        "speaker": "The Tower",
        "text": "Skills grow with use. Pin the ones you use most.",
        "next": "d"
      },
      "d": {
        "speaker": "The Tower",
        "text": "The Status window shows what you are. Open it.",
        "effects": {
          "setFlag": "heard-basics",
