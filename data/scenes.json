    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "Five bundles. That will keep the fields quiet for a while.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "Thank you. Here, for your trouble.",
