  {
    "id": "keeper-belongings-done",
    "npc": "keeper",
    "condition": {
      "flag": "belongings-done",
      "notFlag": "belongings-thanked"
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "You put them back. Each in its place.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "They will find them where they left them. That matters.",
        "effects": {
          "setFlag": "belongings-thanked",
          "bond": 15,
          "exp": 18,
          "coins": 50
        }
      }
    }
  },
  {
    "id": "keeper-table-done",
    "npc": "keeper",
    "condition": {
      "flag": "offered-table",
      "notFlag": "table-set",
      "hasItems": [
        {
          "id": "plate",
          "count": 3
        }
      ]
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "Every place laid. It has not looked like this in a long time.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "You asked who wanted the house kept ready.",
        "next": "c"
      },
      "c": {
        "speaker": "The Keeper",
        "text": "A young man. Polite. He never gave his name.",
        "next": "d"
      },
      "d": {
        "speaker": "The Keeper",
        "text": "He looked at the empty chair for a long time, then thanked me for the tea.",
        "next": "e"
      },
      "e": {
        "speaker": "The Keeper",
        "text": "Take the lamp oil. It burns longer than it should.",
        "effects": {
          "setFlag": "table-set",
          "bond": 20,
          "exp": 18,
          "coins": 50,
          "take": [
            {
              "id": "plate",
              "count": 3
            }
          ],
          "give": [
            {
              "id": "lamp-oil",
              "count": 1
            }
          ]
        }
      }
    }
  },
  {
    "id": "keeper-trusted",
    "npc": "keeper",
    "condition": {
      "bondAtLeast": 3,
      "notFlag": "offered-table"
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "Will you help me set the table? Properly. Every place.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "The plates are in the houses on the row. One from each.",
        "effects": {
          "setFlag": "offered-table"
        }
      }
    }
  },
  {
    "id": "keeper-close",
    "npc": "keeper",
    "condition": {
      "bondAtLeast": 4,
      "notFlag": "keeper-close-done"
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "You keep coming back. That is more than most.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "If they don't come back... No. They will.",
        "next": "c"
      },
      "c": {
        "speaker": "The Keeper",
        "text": "Take something. I have too much of everything.",
        "choices": [
          {
            "text": "Show me how you keep things tidy.",
            "next": "skill"
          },
          {
            "text": "The spare key, if you can part with it.",
            "next": "key"
          }
        ]
      },
      "skill": {
        "speaker": "The Keeper",
        "text": "Like this. One thing at a time, and never in a hurry.",
        "effects": {
          "setFlag": "keeper-close-done",
          "learnSkill": "tidy-up"
        }
      },
      "key": {
        "speaker": "The Keeper",
        "text": "It opens the house. Come in whenever you like.",
        "effects": {
          "setFlag": "keeper-close-done",
          "give": [
            {
              "id": "keepers-spare-key",
              "count": 1
            }
          ]
        }
      }
    }
  },
  {
    "id": "keeper-friendly",
    "npc": "keeper",
    "condition": {
      "bondAtLeast": 2,
      "notFlag": "keeper-friendly-done"
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "Sit. Not that chair.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "They used to argue about the kettle. Who would fill it.",
        "next": "c"
      },
      "c": {
        "speaker": "The Keeper",
        "text": "Now I fill it. Nobody argues.",
        "choices": [
          {
            "text": "That sounds lonely.",
            "next": "d"
          },
          {
            "text": "I'll fill it next time.",
            "liked": true,
            "next": "e"
          },
          {
            "text": "Why do you stay?",
            "next": "f"
          }
        ]
      },
      "d": {
        "speaker": "The Keeper",
        "text": "It is quiet. Quiet is not the same.",
        "next": "g"
      },
      "e": {
        "speaker": "The Keeper",
        "text": "Then I will let you. Just this once.",
        "next": "g"
      },
      "f": {
        "speaker": "The Keeper",
        "text": "Someone has to be here when they come back.",
        "next": "g"
      },
      "g": {
        "speaker": "The Keeper",
        "text": "Drink. It is still warm.",
        "effects": {
          "setFlag": "keeper-friendly-done"
        }
      }
    }
  },
  {
    "id": "keeper-trial",
    "npc": "keeper",
    "condition": {
      "flag": "keeper-at-gate",
      "notFlag": "trial-passed"
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "The Tower wants me to test you. I don't like it.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "I won't try to hurt you. Not really.",
        "next": "c"
      },
      "c": {
        "speaker": "The Keeper",
        "text": "The kettle can wait."
      }
    }
  },
  {
    "id": "keeper-yield",
    "npc": "keeper",
    "condition": {
      "flag": "trial-passed",
      "notFlag": "keeper-farewell"
    },
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "Enough. Enough. You can go.",
        "next": "b"
      },
      "b": {
        "speaker": "The Keeper",
        "text": "The gate is open. Come back if you're tired. The bed is made.",
        "effects": {
          "setFlag": "keeper-farewell"
        }
      }
    }
  },
  {
    "id": "keeper-chat",
    "npc": "keeper",
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "The Keeper",
        "text": "The kettle is warm.",
        "choices": [
          {
            "text": "Tell me about the village.",
            "next": "b"
          },
          {
            "text": "Nothing. Thank you.",
            "next": "c"
          }
        ]
      },
      "b": {
        "speaker": "The Keeper",
        "text": "Fields, a river, a school. Everyone worked. Everyone came home."
      },
      "c": {
        "speaker": "The Keeper",
        "text": "Mind the step on your way out."
      }
    }
  },
